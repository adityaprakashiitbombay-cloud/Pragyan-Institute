# Pragyan Institute Portal - Environment Variables Template
# Copy this file to .env.local for local development
# Configure these in Vercel Dashboard for production

# ============================================================================
# CRITICAL SECURITY SECRETS (REQUIRED)
# ============================================================================

# JWT Session Secret (REQUIRED - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# Must be 128+ characters (64 bytes hex)
PORTAL_SESSION_SECRET=your_128_character_hex_secret_here

# Cron Automation Secret (REQUIRED - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Must be 64+ characters (32 bytes hex)
CRON_SECRET=your_64_character_hex_secret_here

# ============================================================================
# SUPABASE DATABASE CONFIGURATION (REQUIRED)
# ============================================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (Public - Safe to expose in client-side code)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (CRITICAL - Never expose in client-side code)
# This key bypasses Row Level Security - keep it secret!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================================
# EMAIL & AI CONFIGURATION (REQUIRED)
# ============================================================================

# Resend API Key for sending emails (must start with re_)
RESEND_API_KEY=re_your_resend_api_key_here

# From email address (must be verified domain in Resend dashboard)
RESEND_FROM_EMAIL=Pragyan Institute <noreply@pragyaninstitute.com>

# Google Gemini AI API Key (for institute assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Node environment (development | production)
NODE_ENV=development

# API Base URL (for local development)
# PRAGYAN_API_BASE=http://localhost:3000

# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit .env.local or any file containing actual secrets to git
# 2. Rotate all secrets immediately if they are ever exposed
# 3. Use different secrets for development, staging, and production
# 4. Store production secrets only in Vercel Dashboard or GitHub Secrets
# 5. Minimum secret lengths:
#    - PORTAL_SESSION_SECRET: 128 characters (64 bytes)
#    - CRON_SECRET: 64 characters (32 bytes)
#    - SUPABASE_SERVICE_ROLE_KEY: As provided by Supabase
#
# ============================================================================
# GENERATING SECURE SECRETS
# ============================================================================
#
# Run these commands to generate cryptographically secure secrets:
#
# PowerShell:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Linux/Mac:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Or use online generator (use at your own risk):
#   https://www.browserling.com/tools/random-hex
#
# ============================================================================

# GetStream.io Community Chat (free tier: 200 MAU)
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here
